# Copia este archivo como .env y rellena los valores reales.

# Opcion recomendada si la contrasena tiene caracteres especiales.
DB_HOST=host
DB_PORT=5432
DB_NAME=censo_pacientes
DB_USER=usuario
DB_PASSWORD=password

# Alternativa: usar DATABASE_URL solo si usuario/contrasena estan codificados para URL.
DATABASE_URL=
# disable solo en desarrollo local. En produccion usar 'require' como minimo
# ('prefer' permite continuar sin cifrar si el servidor no ofrece TLS o ante
# un downgrade activo en la red); 'verify-full' + DATABASE_SSL_ROOT_CERT es
# el objetivo cuando el proveedor entrega su CA.
DATABASE_SSL_MODE=require
DATABASE_SSL_ROOT_CERT=
DATABASE_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=2

JWT_SECRET_KEY=cambia_esta_clave_por_una_segura_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=cambia_esta_clave_generada_con_fernet

# Clave del HMAC-SHA256 usado para curp_hash/cedula_hash (búsquedas sin
# descifrar). Distinta de FERNET_KEY. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# No cambiar despues si ya hay datos: los hashes existentes dejarian de
# coincidir con las busquedas nuevas (requeriria remigrar los hashes).
HASH_KEY=cambia_esta_clave_generada_con_secrets

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

RUN_MIGRATIONS=false
CREATE_ADMIN_ON_STARTUP=false
# Envío de correos institucionales (SendGrid SMTP) — usado por el autoservicio
# de alta de usuarios (POST /auth/solicitar-acceso) y por "Nuevo usuario".
# Misma cuenta de SendGrid que usa Programación Quirúrgica (compartida a nivel
# institución) — pedir la API key real al equipo, NUNCA inventarla.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=cambia_esta_api_key_de_sendgrid
# Remitente ya verificado en SendGrid (mismo que usa Programación Quirúrgica).
# Si se verifica un remitente propio del Censo, cambiar aquí.
SMTP_FROM=quirurgico-noreply@imssbienestar.gob.mx
# URL del frontend en producción, para el enlace en el correo de acceso.
APP_BASE_URL=http://localhost:5173
