# Copia este archivo como .env y rellena los valores reales.

# Opcion recomendada si la contrasena tiene caracteres especiales.
DB_HOST=host
DB_PORT=5432
DB_NAME=censo_pacientes
DB_USER=usuario
DB_PASSWORD=password

# Alternativa: usar DATABASE_URL solo si usuario/contrasena estan codificados para URL.
DATABASE_URL=
DATABASE_SSL_MODE=prefer
DATABASE_SSL_ROOT_CERT=
DATABASE_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=2

JWT_SECRET_KEY=cambia_esta_clave_por_una_segura_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=cambia_esta_clave_generada_con_fernet

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

RUN_MIGRATIONS=false
CREATE_ADMIN_ON_STARTUP=false
