# Imagenes fijadas por digest (SAST-16): un tag como "22-alpine" es mutable.
# Verificar/actualizar con: docker buildx imagetools inspect <imagen>:<tag>
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build

WORKDIR /app

COPY package.json package-lock.json ./
# npm ci (no npm install): instalacion reproducible desde el lockfile exacto,
# falla si package-lock.json no coincide con package.json (SAST-16).
RUN npm ci

COPY . .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Usuario no-root (SAST-16): nginx:alpine ya trae un usuario "nginx" y
# permisos ajustados para servir en un puerto no privilegiado sin root.
# Puerto 8080 (no 80): <1024 requeriria privilegios que este usuario no tiene.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run \
    && touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]